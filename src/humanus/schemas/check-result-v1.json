{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/check-result-v1.json",
  "title": "CheckResult",
  "description": "Standoff annotation of a document: segments, protected regions and findings, with offsets into the submitted text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "offsetUnit",
    "document",
    "pack",
    "language",
    "segments",
    "protected",
    "findings",
    "coverage",
    "lanes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "offsetUnit": {
      "const": "utf16",
      "description": "All start/end values count UTF-16 code units, as JavaScript string indexes do."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "length"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "version"
      ],
      "properties": {
        "packId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "version"
      ],
      "description": "The language pack the content was read with.",
      "properties": {
        "tag": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "length",
        "language"
      ],
      "description": "The source text a translation was compared with, when the request carried one.",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "version"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "protected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protectedRegion"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding-v1.json"
      }
    },
    "coverage": {
      "type": "array",
      "description": "Every classifier decision, including passes, so the UI and calibration see what was checked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmentId",
          "policyId",
          "detectorId",
          "probability"
        ],
        "properties": {
          "segmentId": {
            "type": "string"
          },
          "policyId": {
            "type": "string"
          },
          "detectorId": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rawProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "classifier"
      ],
      "properties": {
        "rules": {
          "$ref": "#/$defs/laneStatus"
        },
        "classifier": {
          "$ref": "#/$defs/laneStatus"
        },
        "parity": {
          "$ref": "#/$defs/laneStatus"
        },
        "judge": {
          "$ref": "#/$defs/laneStatus"
        }
      },
      "description": "parity and judge appear only when the request carries a source."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classifierRequests": {
          "type": "integer",
          "minimum": 0
        },
        "classifierInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "classifierCacheHits": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start",
        "end",
        "textHash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "paragraph",
            "sentence"
          ]
        },
        "block": {
          "enum": [
            "paragraph",
            "heading",
            "listItem",
            "tableCell"
          ]
        },
        "parentId": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "textHash": {
          "type": "string",
          "description": "Hash of the segment's normalized plain text; equal hashes mean equal prose."
        },
        "text": {
          "type": "string",
          "description": "Plain prose with inline markup removed, as a reader sees it (paragraph and sentence segments). Lets a rendered preview find the segment."
        }
      }
    },
    "protectedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "kind": {
          "enum": [
            "frontMatter",
            "code",
            "directive",
            "quote",
            "table",
            "html"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "laneStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ran",
            "disabled",
            "unavailable",
            "failed",
            "partial"
          ]
        },
        "reason": {
          "type": "string"
        },
        "detectors": {
          "type": "integer",
          "minimum": 0,
          "description": "Detectors this lane evaluated."
        },
        "notRun": {
          "type": "array",
          "description": "Detectors that did not run, each with the reason: the content's language pack lacks what they need, or (parity) the source and translation blocks do not line up.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policyId",
              "detectorId",
              "reason"
            ],
            "properties": {
              "policyId": {
                "type": "string"
              },
              "detectorId": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "description": "Judge answers dropped because a quoted span is not in the text it claims to quote."
        }
      }
    }
  }
}
