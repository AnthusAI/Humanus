{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/check-request-v1.json",
  "title": "CheckRequest",
  "description": "Check one document against a policy pack; with a source, also check it as a translation of that source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "content",
    "pack"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "source": {
      "$ref": "#/$defs/content",
      "description": "The text the content was translated from, with its own language and the content's format. Only parity and judge detectors read it; its findings are faithfulness defects with a span in both texts."
    },
    "glossary": {
      "$ref": "#/$defs/glossary"
    },
    "pack": {
      "$ref": "policy-pack-v1.json"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "boolean",
          "default": true,
          "description": "Check the prose in Markdown table cells (segments with block 'tableCell'). False makes tables a protected region that no lane reads."
        },
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "boolean",
              "default": true
            },
            "classifier": {
              "type": "boolean",
              "default": true
            },
            "parity": {
              "type": "boolean",
              "default": true,
              "description": "Deterministic source-against-translation checks (needs a source)."
            },
            "judge": {
              "type": "boolean",
              "default": true,
              "description": "The bilingual judge (needs a source and a judge supplied by the caller)."
            }
          }
        },
        "classifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "default": "jev-latest"
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "default": 16
            },
            "maxInputTokens": {
              "type": "integer",
              "minimum": 1,
              "description": "Budget; the lane stops and reports when exceeded."
            },
            "examples": {
              "type": "array",
              "description": "Past editor decisions with their text; the most similar ones travel with each question as few-shot examples.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "policyId",
                  "detectorId",
                  "text",
                  "violates"
                ],
                "properties": {
                  "policyId": {
                    "type": "string"
                  },
                  "detectorId": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "violates": {
                    "type": "boolean"
                  }
                }
              }
            },
            "maxExamplesPerQuestion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32,
              "default": 4
            },
            "deadlineSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stop starting new requests after this many seconds; the lane reports partial. Keeps a synchronous API call under its timeout."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "language",
        "text"
      ],
      "properties": {
        "format": {
          "enum": [
            "markus",
            "markdown",
            "text"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "BCP 47 tag of the content's language (en, es, zh-Hans, zh-CN ...). Humanus reads the text with that language's pack; a language with no pack is refused, never read as another language."
        },
        "text": {
          "type": "string"
        }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "entries"
      ],
      "description": "Approved renderings and do-not-translate terms for the content's language, from the publication's glossary. Only parity detectors read it.",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "BCP 47 tag of the language the entries are for; it must be the content's language (or the base language of the content's regional variant)."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glossaryEntry"
          }
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term"
      ],
      "description": "A source-language term and how it must appear in the translation: in one of its approved forms, or unchanged.",
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "The term as the source writes it."
        },
        "translations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Approved forms in the content's language; the first is the one offered as the fix. A name's approved local form goes here (and the original too, when either is acceptable)."
        },
        "doNotTranslate": {
          "const": true,
          "description": "The term must appear unchanged."
        },
        "caseSensitive": {
          "type": "boolean",
          "default": false
        },
        "note": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "translations"
          ]
        },
        {
          "required": [
            "doNotTranslate"
          ]
        }
      ]
    }
  },
  "dependentRequired": {
    "glossary": [
      "source"
    ]
  }
}
