{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/finding-v1.json",
  "title": "Finding",
  "description": "One policy problem located in the document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "policyId",
    "policyVersion",
    "detectorId",
    "lane",
    "severity",
    "status",
    "segmentId",
    "span",
    "excerpt",
    "message"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^f-[0-9a-f]{16}$",
      "description": "Stable across rescans while the policy, detector, segment text and excerpt are unchanged."
    },
    "policyId": {
      "type": "string"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "detectorId": {
      "type": "string"
    },
    "lane": {
      "enum": [
        "rules",
        "classifier",
        "parity",
        "judge"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "status": {
      "enum": [
        "violation",
        "review"
      ],
      "description": "review: the classifier is unsure; an editor should decide."
    },
    "segmentId": {
      "type": "string"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "excerpt": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Classifier probability of violation."
    },
    "replacement": {
      "type": "string",
      "description": "Deterministic replacement for the span, when the detector defines one."
    },
    "rawProbability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The model's probability before calibration; report this one in feedback labels."
    },
    "excerptText": {
      "type": "string",
      "description": "The excerpt as a reader sees it, inline markup removed; locates the finding in a rendered preview."
    },
    "category": {
      "enum": [
        "faithfulness"
      ],
      "description": "faithfulness: the translation does not say what its source says (parity and judge lanes). At error severity it holds publication."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span",
        "excerpt"
      ],
      "description": "Where the finding is in the source text (offsets into the request's source, in the same unit as span).",
      "properties": {
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "passes",
        "agreeing"
      ],
      "description": "The bilingual judge's reading behind a judge-lane finding.",
      "properties": {
        "category": {
          "enum": [
            "mistranslation",
            "omission",
            "addition",
            "certainty-changed",
            "terminology",
            "attribution-changed"
          ]
        },
        "passes": {
          "type": "integer",
          "minimum": 1
        },
        "agreeing": {
          "type": "integer",
          "minimum": 1,
          "description": "Passes that reported this problem; fewer than passes makes the finding status review."
        },
        "explanations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
