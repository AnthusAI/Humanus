{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/finding-v1.json",
  "title": "Finding",
  "description": "One policy problem located in the document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "policyId",
    "policyVersion",
    "detectorId",
    "lane",
    "severity",
    "status",
    "segmentId",
    "span",
    "excerpt",
    "message"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^f-[0-9a-f]{16}$",
      "description": "Stable across rescans while the policy, detector, segment text and excerpt are unchanged."
    },
    "policyId": {
      "type": "string"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "detectorId": {
      "type": "string"
    },
    "lane": {
      "enum": [
        "rules",
        "classifier"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "status": {
      "enum": [
        "violation",
        "review"
      ],
      "description": "review: the classifier is unsure; an editor should decide."
    },
    "segmentId": {
      "type": "string"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "excerpt": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Classifier probability of violation."
    },
    "replacement": {
      "type": "string",
      "description": "Deterministic replacement for the span, when the detector defines one."
    },
    "rawProbability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The model's probability before calibration; report this one in feedback labels."
    },
    "excerptText": {
      "type": "string",
      "description": "The excerpt as a reader sees it, inline markup removed; locates the finding in a rendered preview."
    }
  }
}
