{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/draft-questions-request-v1.json",
  "title": "DraftQuestionsRequest",
  "description": "Ask Luna to draft zero-shot classifier detectors for a policy written in prose. An editor reviews them before they are saved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "guidance"
      ],
      "properties": {
        "id": {
          "$ref": "policy-pack-v1.json#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "guidance": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "$ref": "policy-pack-v1.json#/$defs/policy/properties/examples"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "default": "gpt-6-luna"
        },
        "maxDetectors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 3
        }
      }
    }
  }
}
