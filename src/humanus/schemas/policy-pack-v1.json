{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanus.anth.us/schemas/policy-pack-v1.json",
  "title": "PolicyPack",
  "description": "A versioned set of editorial policies supplied by the caller with each request. Humanus stores no policies of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "version", "language", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packId": { "$ref": "#/$defs/slug" },
    "version": { "type": "string", "minLength": 1, "description": "Caller-assigned pack version, echoed in every result." },
    "title": { "type": "string" },
    "guidance": { "type": "string", "description": "Publication-wide editorial aim, given to rewrite suggestions." },
    "language": {
      "type": "string",
      "minLength": 1,
      "description": "BCP 47 tag of the language the policies are written for, which a Humanus language pack must serve (en, es, zh-Hans ...), or \"*\" for language-neutral policies. A pack is used only on content in its language."
    },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "referenceSamples": { "type": "array", "items": { "$ref": "#/$defs/referenceSample" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128 },
    "severity": { "enum": ["info", "warn", "error"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "guidance", "severity", "detectors"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "guidance": { "type": "string", "minLength": 1, "description": "The policy in prose, for editors and for rewrite suggestions." },
        "severity": { "$ref": "#/$defs/severity" },
        "enabled": { "type": "boolean", "default": true },
        "quotations": { "$ref": "#/$defs/quotations" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "detectors": {
          "type": "array",
          "description": "How the policy is detected. A guidance-only policy has none and produces no findings.",
          "items": { "$ref": "#/$defs/detector" }
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "violates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "complies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "rewriteGuidance": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade"],
      "description": "How well the policy's pattern is known to indicate the problem: measured (a corpus study), normative (a published standard) or folk (editors' observation, not measured).",
      "properties": {
        "grade": { "enum": ["measured", "normative", "folk"] },
        "note": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "detector": {
      "oneOf": [
        { "$ref": "#/$defs/regexDetector" },
        { "$ref": "#/$defs/phraseDetector" },
        { "$ref": "#/$defs/builtinDetector" },
        { "$ref": "#/$defs/classifierDetector" },
        { "$ref": "#/$defs/parityDetector" },
        { "$ref": "#/$defs/judgeDetector" }
      ]
    },
    "detectorBase": {
      "type": "object",
      "required": ["id", "lane"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "message": { "type": "string", "description": "Shown on each finding from this detector." },
        "blocks": {
          "type": "array",
          "description": "Prose blocks the detector applies to. Defaults to all.",
          "items": { "$ref": "#/$defs/block" },
          "minItems": 1
        }
      }
    },
    "block": { "enum": ["paragraph", "heading", "listItem", "tableCell"] },
    "quotations": {
      "enum": ["exempt", "check"],
      "description": "Whether a rules finding that lies entirely inside a direct quotation (double quotes or a block quote) is reported. Defaults to exempt; a detector overrides its policy."
    },
    "regexDetector": {
      "allOf": [{ "$ref": "#/$defs/detectorBase" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "kind", "pattern"],
      "properties": {
        "lane": { "const": "rules" },
        "kind": { "const": "regex" },
        "pattern": { "type": "string", "minLength": 1, "description": "Python regular expression." },
        "ignoreCase": { "type": "boolean", "default": false },
        "exceptions": { "type": "array", "items": { "type": "string" }, "description": "Regexes; a match inside an exception match is not a finding." },
        "quotations": { "$ref": "#/$defs/quotations" }
      }
    },
    "phraseDetector": {
      "allOf": [{ "$ref": "#/$defs/detectorBase" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "kind", "phrases"],
      "properties": {
        "lane": { "const": "rules" },
        "kind": { "const": "phrase" },
        "phrases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "caseSensitive": { "type": "boolean", "default": false },
        "exceptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Phrases, such as technical names, inside which a match is not a finding."
        },
        "replacement": { "type": "string", "description": "Preferred wording, offered as a deterministic suggestion." },
        "quotations": { "$ref": "#/$defs/quotations" }
      }
    },
    "builtinDetector": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "kind", "check"],
      "properties": {
        "lane": { "const": "rules" },
        "kind": { "const": "builtin" },
        "check": {
          "enum": [
            "empty_leadin",
            "list_shaped_prose",
            "vague_claim",
            "unsupported_certainty",
            "uniform_cadence",
            "redundancy",
            "passive_voice",
            "missing_attribution",
            "information_density",
            "overused_words",
            "uncontracted_forms",
            "contrast_cap",
            "no_emojis",
            "sentence_length",
            "average_sentence_length",
            "paragraph_length",
            "reading_grade_level",
            "double_negative",
            "undefined_acronym",
            "multiple_instructions",
            "imperative_steps",
            "ing_form",
            "missing_article",
            "one_meaning",
            "frame",
            "density",
            "typography"
          ]
        },
        "params": { "type": "object" },
        "quotations": { "$ref": "#/$defs/quotations" }
      },
      "allOf": [
        { "$ref": "#/$defs/detectorBase" },
        {
          "if": { "properties": { "check": { "const": "contrast_cap" } } },
          "then": {
            "required": ["params"],
            "properties": { "params": { "type": "object", "required": ["max"], "properties": { "max": { "type": "integer", "minimum": 0 } } } }
          }
        },
        {
          "if": { "properties": { "check": { "const": "frame" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["parts"],
                "description": "Ordered parts, each found after the one before within one sentence (or paragraph), with at most maxGap units of the language between them.",
                "properties": {
                  "parts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
                  "maxGap": { "type": "integer", "minimum": 0, "default": 30 },
                  "within": { "enum": ["sentence", "paragraph"], "default": "sentence" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "density" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "description": "How often a word class occurs in each paragraph, compared with the language pack's native baseline rate for that class. A paragraph is reported when so many occurrences would be improbable (Poisson, below 'significance') at the native rate.",
                "properties": {
                  "lexicon": { "type": "string", "minLength": 1, "description": "A word class in the language pack." },
                  "tag": { "type": "string", "minLength": 1, "description": "A part-of-speech tag; needs a language pack with a tagger." },
                  "significance": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "default": 0.01 }
                },
                "oneOf": [{ "required": ["lexicon"] }, { "required": ["tag"] }]
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "typography" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule"],
                "description": "A mechanical typography rule whose data comes from the language pack; every finding carries its deterministic replacement.",
                "properties": {
                  "rule": {
                    "enum": [
                      "punctuation-width",
                      "quotation-marks",
                      "ellipsis",
                      "space-beside-full-width",
                      "latin-spacing",
                      "number-words",
                      "number-format"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "information_density" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minWords": { "type": "integer", "minimum": 0 },
                  "minLexicalDensity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "maxGzipRatio": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "sentence_length" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxWords"],
                "properties": {
                  "maxWords": { "type": "integer", "minimum": 1 },
                  "topic": { "$ref": "#/$defs/topic" },
                  "imperativeVerbs": { "$ref": "#/$defs/wordList" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "average_sentence_length" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxWords"],
                "properties": {
                  "maxWords": { "type": "number", "minimum": 1 },
                  "minSentences": { "type": "integer", "minimum": 1, "description": "Skip documents with fewer sentences. Default 1." }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "paragraph_length" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "maxSentences": { "type": "integer", "minimum": 1 },
                  "maxWords": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "reading_grade_level" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxGrade"],
                "properties": {
                  "maxGrade": { "type": "number", "minimum": 0, "description": "Highest acceptable Flesch-Kincaid grade level." },
                  "minWords": { "type": "integer", "minimum": 1, "description": "Skip documents shorter than this. Default 100." }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "undefined_acronym" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "allow": { "$ref": "#/$defs/wordList", "description": "Acronyms readers know without a definition." } }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "enum": ["multiple_instructions", "imperative_steps"] } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "imperativeVerbs": { "$ref": "#/$defs/wordList" },
                  "wholeDocument": { "type": "boolean", "description": "Treat every paragraph as a procedure step, for documents that are only procedures." }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "ing_form" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "allow": { "$ref": "#/$defs/wordList", "description": "-ing words that are allowed, such as technical nouns." } }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "missing_article" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nouns"],
                "properties": { "nouns": { "$ref": "#/$defs/wordList", "description": "Singular nouns that need an article." } }
              }
            }
          }
        },
        {
          "if": { "properties": { "check": { "const": "one_meaning" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["words"],
                "properties": {
                  "words": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["word", "meaning"],
                      "properties": {
                        "word": { "type": "string", "minLength": 1 },
                        "meaning": { "enum": ["noun", "verb"], "description": "The one part of speech the word may be used as." }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "topic": {
      "enum": ["any", "procedure", "description"],
      "description": "Which sentences a check applies to. Procedure sentences are list items and paragraphs that start with an imperative verb."
    },
    "wordList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "classifierDetector": {
      "allOf": [{ "$ref": "#/$defs/detectorBase" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "scope", "question", "violation", "threshold"],
      "properties": {
        "lane": { "const": "classifier" },
        "scope": { "enum": ["sentence", "paragraph", "document"] },
        "question": { "$ref": "#/$defs/question" },
        "violation": {
          "description": "Which answer means the segment violates the policy.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["answer"],
              "properties": { "answer": { "enum": ["yes", "no"] } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["labels"],
              "properties": { "labels": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["scoreBelow"],
              "properties": { "scoreBelow": { "type": "number" } }
            }
          ]
        },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "Probability of violation at or above which a finding is a violation." },
        "reviewAt": { "type": "number", "minimum": 0, "maximum": 1, "description": "Probability at or above which (and below threshold) a finding needs review." },
        "calibration": { "$ref": "#/$defs/calibration" }
      }
    },
    "calibration": {
      "description": "Maps the model's raw probability to a calibrated one before thresholds apply. Produced by `humanus calibrate`.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "points"],
          "properties": {
            "method": { "const": "isotonic" },
            "points": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number", "minimum": 0, "maximum": 1 }], "minItems": 2, "maxItems": 2 }
            },
            "labels": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "a", "b"],
          "properties": {
            "method": { "const": "platt" },
            "a": { "type": "number" },
            "b": { "type": "number" },
            "labels": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": { "enum": ["noul", "choice", "score"] },
        "instructions": { "type": "string", "minLength": 1 },
        "criteria": {
          "description": "noul: optional {true, false} descriptions. choice: answer label to description (or null). score: ordered level descriptions, level 0 first."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "noul" } } },
          "then": {
            "properties": {
              "criteria": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "true": { "type": "string" }, "false": { "type": "string" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": {
            "required": ["criteria"],
            "properties": {
              "criteria": { "type": "object", "minProperties": 2, "additionalProperties": { "type": ["string", "null"] } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "score" } } },
          "then": {
            "required": ["criteria"],
            "properties": { "criteria": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } }
          }
        }
      ]
    },
    "parityDetector": {
      "description": "A deterministic comparison of the content (a translation) with the check request's source text. Runs only on a request that carries a source; its findings are faithfulness defects.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "check"],
      "properties": {
        "lane": { "const": "parity" },
        "check": {
          "enum": [
            "structure", "links", "citations", "code", "directives", "numbers", "iso_dates", "names",
            "glossary", "quotations", "emphasis", "hedges", "attributions", "sentence_count"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        { "$ref": "#/$defs/detectorBase" },
        {
          "if": { "properties": { "check": { "const": "directives" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["translatable"],
                "description": "Directive attributes whose values a translator translates (alt, caption, title ...). Every other attribute (src, layout, credit ...) must be byte-identical to the source.",
                "properties": { "translatable": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
              }
            }
          },
          "else": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
        }
      ]
    },
    "judgeDetector": {
      "description": "A bilingual model judge reads each source block beside its translation and marks spans by MQM category, quoting both sides; code confirms each quote is in the text. Runs only on a request that carries a source, with a judge supplied by the caller.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["lane", "passes"],
      "properties": {
        "lane": { "const": "judge" },
        "passes": {
          "type": "integer",
          "minimum": 2,
          "description": "Independent passes over each block. A problem every pass reports is a violation; one that only some passes report is for review, so a block is clean only when the passes agree."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mistranslation", "omission", "addition", "certainty-changed", "terminology", "attribution-changed"] },
          "default": ["mistranslation", "omission", "addition", "certainty-changed", "terminology", "attribution-changed"]
        }
      },
      "allOf": [{ "$ref": "#/$defs/detectorBase" }]
    },
    "referenceSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
