{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limatus.anth.us/schemas/check-request-v1.json",
  "title": "CheckRequest",
  "description": "Check one document against a policy pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "content", "pack"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "content": { "$ref": "#/$defs/content" },
    "pack": { "$ref": "policy-pack-v1.json" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": { "type": "boolean", "default": true },
            "classifier": { "type": "boolean", "default": true }
          }
        },
        "classifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "default": "jev-latest" },
            "maxConcurrency": { "type": "integer", "minimum": 1, "default": 16 },
            "maxInputTokens": { "type": "integer", "minimum": 1, "description": "Budget; the lane stops and reports when exceeded." }
          }
        }
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "text"],
      "properties": {
        "format": { "enum": ["markus", "markdown", "text"] },
        "text": { "type": "string" }
      }
    }
  }
}
